[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[dev-packages]
fastparquet = "*"
freezegun = "*"
ipython = "*"
ipykernel = "*"
mkdocs = "*"
mkdocs-autorefs = "*"
mkdocs-include-markdown-plugin = "*"
mkdocs-macros-plugin = "*"
mkdocs-material = "==7.3.0"
mkdocs-material-extensions = "*"
mkdocstrings = "*"
mongomock = "*"
requests = "*"
ruff = "*"
pandas-stubs = "*"
playwright = "*"
pre-commit = "*"
pyopenssl = "*"
pytest = "==7.4.3"
pytest-cov = "*"
pytest-mock = "*"
pytest-playwright = "*"
pytest-timeout = "*"
python-dotenv = "*"
testbook = "*"
tox = "*"
twine = "*"
types-flask = "*"
types-Flask-Cors = "*"
types-Markdown = "*"
types-python-dateutil = "*"
types-pytz = "*"
types-toml = ">=0.10.0"
types-tzlocal = "*"
websocket-client = "*"

[requires]
python_version = "3"

[pipenv]
allow_prereleases = false

[dev-packages.moto]
extras = [ "s3",]
version = "==4.2.13"


[packages]
"pyarrow" = {version="==26.0.0"}
"networkx" = {version="==3.6.1", markers="python_version>'3.8'"}
"openpyxl" = {version="==3.1.5"}
"pandas" = {version="==3.1.0", markers="python_version>'3.8'"}
"pymongo" = {version="==4.19.0", extras=["srv"]}
"sqlalchemy" = {version="==2.1.6"}
"toml" = {version="==0.10.2"}
"boto3" = {version="==1.43.123"}
"cookiecutter" = {version="==2.7.1"}
"flask" = {version="==3.1.3"}
"flask-cors" = {version="==6.0.5"}
"flask-socketio" = {version="==5.7.0"}
"markdown" = {version="==3.11.2"}
"python-dotenv" = {version="==1.2.4"}
"pytz" = {version="==2026.6"}
"tzlocal" = {version="==5.4.5"}
"gevent" = {version="==26.9.0"}
"gevent-websocket" = {version="==0.10.1"}
"kthread" = {version="==0.2.3"}
"gitignore-parser" = {version="==0.1.13"}
"simple-websocket" = {version="==1.1.0"}
"twisted" = {version="==26.10.0"}
"deepdiff" = {version="==9.1.0"}
"flask-restful" = {version="==0.3.10"}
"passlib" = {version="==1.7.4"}
"marshmallow" = {version="==4.3.1"}
"apispec" = {version="==6.10.0", extras=["yaml"]}
"apispec-webframeworks" = {version="==1.2.0"}
"watchdog" = {version="==7.0.0"}
"charset-normalizer" = {version="==3.5.2"}
